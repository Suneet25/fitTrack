# Copy to .env.local and fill in.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase — Project settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Starts with G- ; required for Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Health API — Google Cloud Console → APIs & Services
#   1. Library → enable "Google Health API"
#   2. OAuth consent screen → Data access → add these scopes, and add yourself as a test user:
#        googlehealth.activity_and_fitness.readonly
#        googlehealth.health_metrics_and_measurements.readonly
#        googlehealth.sleep.readonly
#   3. Credentials → OAuth client ID (Web application), authorized redirect URI:
#      http://localhost:3000/api/google-health/callback  (plus your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored refresh tokens. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
